# MCP Chatbot Server Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM API Keys (Required - At least one)
# =============================================================================

# Groq API Key (Primary LLM provider)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Alternative LLM provider)
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# External Service API Keys
# =============================================================================

# Notion Integration Token
NOTION_TOKEN=your_notion_token_here

# OpenWeatherMap API Key (for weather functionality)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# GNews API Key (for news functionality)
GNEWS_API_KEY=your_gnews_api_key_here

# =============================================================================
# Server Configuration
# =============================================================================

# Port for the FastAPI server (default: 8001)
PORT=8001

# Python path (usually /app in production)
PYTHONPATH=/app

# Display for browser automation (usually :1 in containers)
DISPLAY=:1

# =============================================================================
# CORS Configuration (for frontend integration)
# =============================================================================

# Allowed origins for CORS (comma-separated list)
# Add your Vercel frontend URLs here
ALLOWED_ORIGINS=http://localhost:4173,http://localhost:3000,https://your-app.vercel.app

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database path for SQLite (default: ./test.db)
DATABASE_PATH=./test.db

# Maximum number of concurrent requests
MAX_CONCURRENT_REQUESTS=100

# Request timeout in seconds
REQUEST_TIMEOUT=30
